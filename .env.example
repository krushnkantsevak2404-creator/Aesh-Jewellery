# Public Store URL (used for Canonical SEO, OpenGraph images, and XML sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Integration (10-digit Indian mobile or full international format without +)
# Current default: 919099876252
NEXT_PUBLIC_WHATSAPP_NUMBER=919099876252

# Instagram Profile Handle
NEXT_PUBLIC_INSTAGRAM_HANDLE=sevakcreation

# ------------------------------------------------------------------------------
# Payment Gateway Configuration (Razorpay India)
# ------------------------------------------------------------------------------
# Obtain keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# ------------------------------------------------------------------------------
# AI Shopping Assistant ("Sevak Assistant")
# ------------------------------------------------------------------------------
# Optional: Connect OpenAI or Google Gemini for dynamic conversational responses.
# The assistant already includes a grounded fallback engine with the catalogue data.
OPENAI_API_KEY=
# or
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Admin Dashboard Protection
# ------------------------------------------------------------------------------
ADMIN_ACCESS_TOKEN=sevak_admin_secret_token_2026
